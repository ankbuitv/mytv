name: VeoTV watchdog

on:
  schedule:
    # Kiểm tra mỗi 5 phút.
    - cron: "*/5 * * * *"

  workflow_dispatch:

permissions:
  actions: write
  contents: read

concurrency:
  group: veotv-watchdog
  cancel-in-progress: false

jobs:
  check-and-start:
    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: Check VeoTV and start if needed
        uses: actions/github-script@v7
        with:
          script: |
            const owner = context.repo.owner;
            const repo = context.repo.repo;

            // ĐỔI tên này thành đúng tên file YAML VeoTV của bro.
            // Ví dụ nếu file là .github/workflows/live.yml
            // thì ghi: live.yml
            const workflowFile = "rtmp.yml";

            // Workflow đích sẽ chạy từ nhánh mặc định.
            const { data: repository } = await github.rest.repos.get({
              owner,
              repo
            });

            const ref = repository.default_branch;

            console.log(`Repository: ${owner}/${repo}`);
            console.log(`Workflow cần theo dõi: ${workflowFile}`);
            console.log(`Nhánh: ${ref}`);

            let runs;

            try {
              runs = await github.paginate(
                github.rest.actions.listWorkflowRuns,
                {
                  owner,
                  repo,
                  workflow_id: workflowFile,
                  per_page: 100
                }
              );
            } catch (error) {
              core.setFailed(
                "Không đọc được workflow VeoTV. " +
                "Kiểm tra workflowFile và quyền Actions. " +
                `Lỗi: ${error.message}`
              );
              return;
            }

            const activeStatuses = new Set([
              "queued",
              "in_progress",
              "waiting",
              "pending",
              "requested"
            ]);

            const active = runs.filter(run =>
              activeStatuses.has(run.status)
            );

            if (active.length > 0) {
              for (const run of active) {
                console.log(
                  `VeoTV đã có run #${run.run_number}, ` +
                  `trạng thái: ${run.status}, ID: ${run.id}`
                );
              }

              console.log("Không tạo thêm job.");
              return;
            }

            console.log(
              "Không có run VeoTV đang chạy hoặc chờ; " +
              "gửi yêu cầu khởi động."
            );

            try {
              await github.rest.actions.createWorkflowDispatch({
                owner,
                repo,
                workflow_id: workflowFile,
                ref
              });

              console.log(
                "Đã gửi workflow_dispatch thành công. " +
                "Job mới có thể cần thời gian xếp hàng."
              );
            } catch (error) {
              core.setFailed(
                "Không khởi động được workflow VeoTV: " +
                error.message
              );
            }
